# Host-level environment — the DEFAULT profile.
#
# This is the multiplexing host, not an agent. No Matrix credentials and no
# API keys here: Hermes resolves each profile's secrets from that profile's
# own .env and never inherits from this one. Leaving this file free of secrets
# is what keeps both agents equal.
#
#   cp .env.example ${DATA_ROOT}/hermes-data/.env && chmod 0666 ${DATA_ROOT}/hermes-data/.env

# Dates are handled as DD/MM. Applies to the host and mirrors the container TZ.
HERMES_TIMEZONE=Europe/Amsterdam

# The dashboard runs under the default profile's home, so its public URL is
# declared here. Must match the Caddy site name or the dashboard's HTTP Host /
# WebSocket Origin guard rejects requests — the hostname never appears in the
# container's own bind address.
HERMES_DASHBOARD_PUBLIC_URL=http://hermes.internal

# ── Dashboard auth (REQUIRED — not optional) ────────────────────────────
# Hermes refuses to bind the dashboard to 0.0.0.0 without an auth provider,
# and a configured HERMES_DASHBOARD_PUBLIC_URL requires auth even when a
# reverse proxy is the only thing reaching it. There is no unauthenticated
# public-dashboard option. Change the password here and restart.
#
#   openssl rand -base64 18 | tr -d '/+=' | head -c 20
#
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=admin
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=
