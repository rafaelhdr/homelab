# Hermes Agent secrets — root profile.
#
# Copy to ${DATA_ROOT}/hermes-data/profiles/root/.env and fill in. Live state,
# outside the git tree, never committed.
#
#   cp .env.example ${DATA_ROOT}/hermes-data/profiles/root/.env && chmod 600 ${DATA_ROOT}/hermes-data/profiles/root/.env
#
# Note this profile has its OWN secret scope. Nothing is inherited from the
# ons-thuis profile — XIAOMI_API_KEY must be repeated here even if identical.

# ── LLM: Xiaomi MiMo ────────────────────────────────────────────────────
# Token-plan key (`tp-…`) plus its endpoint — see ../ons-thuis/.env.example
# for why the base URL override is required rather than optional.
XIAOMI_API_KEY=
XIAOMI_BASE_URL=https://token-plan-sgp.xiaomimimo.com/v1

# ── Matrix ──────────────────────────────────────────────────────────────
MATRIX_HOMESERVER=https://matrix.org
MATRIX_USER_ID=
MATRIX_ALLOWED_USERS=

# This profile's own device credential — must differ from ons-thuis's.
MATRIX_ACCESS_TOKEN=
MATRIX_DEVICE_ID=

MATRIX_ENCRYPTION=true
MATRIX_E2EE_MODE=required
MATRIX_RECOVERY_KEY=

# Room scoping. Fill in the *root* room id here, not the home/grocery one.
MATRIX_HOME_ROOM=
MATRIX_ALLOWED_ROOMS=
MATRIX_REQUIRE_MENTION=false
MATRIX_FREE_RESPONSE_ROOMS=

# ── Runtime ─────────────────────────────────────────────────────────────
HERMES_TIMEZONE=Europe/Amsterdam

# ── Homelab ops MCP ─────────────────────────────────────────────────────
# Bearer token for the host-side ops MCP server (service start/stop/status
# under an operator-approved allowlist — see the mcp_servers block in
# config.yaml.example). Same value the server issued for this principal;
# generate both sides with `openssl rand -hex 32`. Leave empty and comment
# the block out if no ops server runs.
HOMELAB_MCP_TOKEN=

# ── GitHub App (not migrated) ───────────────────────────────────────────
# The `monthly-repo-updates` cron job needs `gh` authenticated as the
# rafaelhdr-bot GitHub App. Neither is in the image yet, so the job ships
# disabled. When you add them, set these and drop github_app.pem next to
# this file — see AGENTS.md in this directory for the renewal procedure.
# GITHUB_APP_ID=
