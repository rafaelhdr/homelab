# Hermes Agent secrets — sweet-home profile (named profile).
#
# Copy to ${DATA_ROOT}/hermes-data/profiles/sweet-home/.env and fill in. That
# copy is live state, sits outside the git tree, and must never be committed.
#
#   cp .env.example ${DATA_ROOT}/hermes-data/profiles/sweet-home/.env && chmod 0666 ${DATA_ROOT}/hermes-data/profiles/sweet-home/.env
#
# Secrets (API keys, bot tokens, passwords) belong here; everything else goes
# in config.yaml. Hermes reads this file as the profile's whole secret scope —
# a named profile never inherits the host's or a sibling's values, so
# XIAOMI_API_KEY has to be repeated here even if identical to root's.

# ── LLM: Xiaomi MiMo ────────────────────────────────────────────────────
# https://platform.xiaomimimo.com — provider `xiaomi` in config.yaml.
#
# Xiaomi issues TWO kinds of key and they are not interchangeable:
#
#   sk-…  pay-as-you-go.  Valid on https://api.xiaomimimo.com/v1 (Hermes'
#         default). Inference fails 402 "Insufficient account balance"
#         unless the account is topped up.
#   tp-…  token plan (flat subscription). ONLY valid on the token-plan
#         endpoint below — the same key gets 401 "Invalid API Key" from
#         api.xiaomimimo.com.
#
# This deployment uses the token-plan key, so the base URL override is
# required, not optional. Leave it out and a tp- key reports 401.
XIAOMI_API_KEY=
XIAOMI_BASE_URL=https://token-plan-sgp.xiaomimimo.com/v1

# ── Matrix ──────────────────────────────────────────────────────────────
# The homeserver and bot account this profile speaks as.
MATRIX_HOMESERVER=https://matrix.org
MATRIX_USER_ID=
# Who may talk to the bot. Comma-separated MXIDs, no spaces.
MATRIX_ALLOWED_USERS=

# Device credential, unique to this profile. Mint one per profile with
# m.login.password and PIN the device id — a restart must never mint a new
# device, or every boot leaves another orphan behind. Same MXID as the root
# profile is fine (different device = different token = no multiplexer
# duplicate-credential conflict).
MATRIX_ACCESS_TOKEN=
MATRIX_DEVICE_ID=

# End-to-end encryption. These rooms are encrypted and E2EE is required.
# A freshly-minted device reads history with the account's existing recovery key.
MATRIX_ENCRYPTION=true
MATRIX_E2EE_MODE=required
MATRIX_RECOVERY_KEY=

# Room scoping. HOME_ROOM is where the bot lives and delivers cron output;
# ALLOWED_ROOMS is the full set it will answer in. Fill in the *home/grocery*
# room id (get it from Element: room settings → Advanced → Internal room ID).
MATRIX_HOME_ROOM=
MATRIX_ALLOWED_ROOMS=
# Answer without being @mentioned. The home room is a 1:1 household chat.
MATRIX_REQUIRE_MENTION=false
MATRIX_FREE_RESPONSE_ROOMS=

# ── Runtime ─────────────────────────────────────────────────────────────
# Dates are handled as DD/MM. Also mirrors the container TZ.
HERMES_TIMEZONE=Europe/Amsterdam
