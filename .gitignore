# Environment files
.env

# uv virtual environments
.venv/

# OS metadata
.DS_Store
Thumbs.db

# Editor
*.swp
*.swo
*~
.vscode/

# ai-jail
.ai-jail

# Restore drill — generated/secret; only the checked-in scripts are tracked
restore-drill/*
!restore-drill/keys.txt.example
!restore-drill/setup.sh
!restore-drill/restore.sh

# containerd service data — live state, never commit. Gitea's app.ini holds
# its generated SECRET_KEY/INTERNAL_TOKEN, and the tree holds every repo.
containerd/gitea/

# Hermes live state: the seeded config.yaml (Hermes rewrites it on migration),
# per-profile .env secrets and Matrix device tokens, state.db, sessions and the
# E2EE crypto store. Note `containerd/hermes/` is the *tracked* source — the
# `-data` suffix is what keeps the two apart under a DATA_ROOT of `.`.
containerd/hermes-data/

# Plik uploads and its SQLite metadata DB.
containerd/plik/
